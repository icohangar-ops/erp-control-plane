# =============================================================================
# bmd-erp-control-plane — environment template
# Copy to `.env` and fill in per-deployment values. NEVER commit a filled .env.
# All credentials below are placeholders; the seeded demo needs none of them.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Where the data lake (Parquet) and the DuckDB analytics file are written.
LAKE_ROOT=./data/lake
ANALYTICS_DUCKDB_PATH=./data/analytics/analytics.duckdb
QUARANTINE_ROOT=./data/quarantine

# --- Control plane metadata store --------------------------------------------
# sqlite: zero-dependency demo path. postgres: what `docker compose up` uses.
CONTROL_PLANE_BACKEND=sqlite
CONTROL_PLANE_SQLITE_PATH=./data/control_plane.sqlite3
CONTROL_PLANE_DSN=postgresql://control_plane:control_plane@localhost:5432/control_plane

# --- Postgres (used when CONTROL_PLANE_BACKEND=postgres or via compose) ------
POSTGRES_USER=control_plane
POSTGRES_PASSWORD=change-me-in-any-real-deployment
POSTGRES_DB=control_plane
POSTGRES_PORT=5432

# --- Dagster (container deployment) ------------------------------------------
DAGSTER_HOME=./orchestration/dagster_home
DAGSTER_PG_HOST=postgres
DAGSTER_PG_PORT=5432
DAGSTER_PG_USER=control_plane
DAGSTER_PG_PASSWORD=change-me-in-any-real-deployment
DAGSTER_PG_DB=control_plane

# --- Source registry overrides (optional; defaults in connectors/sources.yml) -
CSV_SFTP_ROOT=./seed/dealer_export

# --- NetSuite (connector: netsuite — UNEXERCISED until a live tenant signs off)
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# --- BisTrack (connector: bistrack — skeleton) -------------------------------
# on_prem_sql | smart_view_api
BISTRACK_MODE=on_prem_sql
BISTRACK_ODBC_DSN=
BISTRACK_API_BASE_URL=
BISTRACK_API_CLIENT_ID=
BISTRACK_API_CLIENT_SECRET=

# --- Superset (compose profile `bi`) -----------------------------------------
SUPERSET_SECRET_KEY=generate-a-real-secret-before-first-boot
