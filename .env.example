# Control-plane metadata store: sqlite (demo default) or postgres (docker compose).
CONTROL_PLANE_BACKEND=sqlite
CP_PG_HOST=localhost
CP_PG_PORT=5432
CP_PG_USER=control_plane
CP_PG_PASSWORD=control_plane_dev_only
CP_PG_DB=control_plane
DAGSTER_PG_URL=postgresql://control_plane:control_plane_dev_only@localhost/dagster

# Analytics lake paths (defaults are relative to the repo root).
LAKE_ROOT=data/lake
ANALYTICS_DUCKDB_PATH=data/analytics/analytics.duckdb

# csv_sftp demo source: local seeded export; no real credentials anywhere.
RIDGELINE_EXPORT_DIR=seed/dealer_export

# Superset (docker compose --profile bi).
SUPERSET_SECRET_KEY=dev_only_change_me

# GenBI / WrenAI (docker compose --profile genbi). The API key is injected as a
# secret (SECRET_OPENAI_API_KEY) or exported in your shell — never committed.
# Model configuration lives in docker/compose/genbi/config.yaml, not here.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Offline profile (docker compose --profile genbi --profile genbi-offline):
# point the AI service at Ollama and pick its config file.
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://ollama:11434/v1
# GENBI_AI_CONFIG_PATH=/app/config-offline.yaml
GENBI_WREN_UI_PORT=3001
# Where the read-only analytics DuckDB lives on the host (mounted into the
# engine/ibis containers at /data/analytics).
GENBI_ANALYTICS_DUCKDB_HOST_PATH=./data/analytics

# ---------------------------------------------------------------------------
# Connector source settings (sources.yml references these; all optional until
# a site's connector is enabled — templates stay disabled with empty values).
# Values live ONLY here / the environment, never in the repo.
# ---------------------------------------------------------------------------

# File source (demo): local seeded export.
# CSV_SFTP_DROP_ROOT=seed/dealer_export

# NetSuite (SuiteTalk REST): account + OAuth1/2 credentials.
# NS_ACCOUNT=, NS_CONSUMER_KEY=, NS_CONSUMER_SECRET=, NS_TOKEN_ID=, NS_TOKEN_SECRET=

# Legacy SQL pack — ODBC DSNs are configured at the OS level (odbc.ini); the
# DSN carries host/port/db. Users and passwords come from the environment.
# INFORMIX_ODBC_DSN=, INFORMIX_DB_USER=, INFORMIX_DB_PASSWORD=
# DB2_LUW_ODBC_DSN=, DB2_LUW_DB_USER=, DB2_LUW_DB_PASSWORD=
# ORACLE_ODBC_DSN=, ORACLE_DB_USER=, ORACLE_DB_PASSWORD=
# SQLSERVER_ODBC_DSN=, SQLSERVER_DB_USER=, SQLSERVER_DB_PASSWORD=
# Db2 for i: JDBC via the JT400 toolkit (JayDeBeApi bridge; JVM required).
# DB2I_JDBC_URL=jdbc:as400://host;naming=system
# DB2I_DB_USER=, DB2I_DB_PASSWORD=, DB2I_JT400_JARS=/opt/jt400
# PostgreSQL / MySQL / MariaDB (psycopg2 / PyMySQL paramstyle %s).
# PG_DB_HOST=, PG_DB_PORT=5432, PG_DB_NAME=, PG_DB_USER=, PG_DB_PASSWORD=
# MYSQL_DB_HOST=, MYSQL_DB_PORT=3306, MYSQL_DB_NAME=, MYSQL_DB_USER=, MYSQL_DB_PASSWORD=
# MARIADB_DB_HOST=, MARIADB_DB_PORT=3306, MARIADB_DB_NAME=, MARIADB_DB_USER=, MARIADB_DB_PASSWORD=
# Sybase ASE: jConnect JDBC only (no Debezium connector exists). Soft-delete
# settings are optional and must be set together.
# SYBASE_JDBC_URL=jdbc:sybase:Tds:host:5000
# SYBASE_DB_USER=, SYBASE_DB_PASSWORD=, SYBASE_JCONNECT_JARS=
# SYBASE_SOFT_DELETE_COLUMN=, SYBASE_SOFT_DELETE_VALUE=
# Progress OpenEdge: pyodbc/DataDirect ODBC (no SQLAlchemy dialect exists).
# OPENEDGE_ODBC_DSN=, OPENEDGE_DB_USER=, OPENEDGE_DB_PASSWORD=

# Epicor Prophet 21 (choose SQL Server on-prem or cloud OData).
# P21_MODE=sql|odata, P21_SQL_DSN=, P21_ODATA_URL=, P21_ODATA_USER=, P21_ODATA_PASSWORD=

# Warehouse direct-connect (connectors/warehouses/warehouses.yml — configs
# only; no extraction). See the file for the full per-warehouse key list.
# SNOWFLAKE_ACCOUNT=, SNOWFLAKE_WAREHOUSE=, SNOWFLAKE_DATABASE=, SNOWFLAKE_SCHEMA=, SNOWFLAKE_USER=, SNOWFLAKE_PASSWORD=, SNOWFLAKE_ROLE=
# BIGQUERY_PROJECT=, BIGQUERY_DATASET=, BIGQUERY_LOCATION=US, BIGQUERY_CREDENTIALS_PATH=
# CLICKHOUSE_HOST=, CLICKHOUSE_PORT=8443, CLICKHOUSE_USER=, CLICKHOUSE_PASSWORD=, CLICKHOUSE_DATABASE=, CLICKHOUSE_SECURE=true
# TRINO_HOST=, TRINO_PORT=8443, TRINO_USER=, TRINO_CATALOG=, TRINO_SCHEMA=, TRINO_PASSWORD=
# DATABRICKS_SERVER_HOSTNAME=, DATABRICKS_HTTP_PATH=, DATABRICKS_ACCESS_TOKEN=, DATABRICKS_CATALOG=, DATABRICKS_SCHEMA=
