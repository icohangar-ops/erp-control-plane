# Control-plane metadata store: sqlite (demo default) or postgres (docker compose).
CONTROL_PLANE_BACKEND=sqlite
CP_PG_HOST=localhost
CP_PG_PORT=5432
CP_PG_USER=control_plane
CP_PG_PASSWORD=control_plane_dev_only
CP_PG_DB=control_plane
DAGSTER_PG_URL=postgresql://control_plane:control_plane_dev_only@localhost/dagster

# Analytics lake paths (defaults are relative to the repo root).
LAKE_ROOT=data/lake
ANALYTICS_DUCKDB_PATH=data/analytics/analytics.duckdb

# csv_sftp demo source: local seeded export; no real credentials anywhere.
RIDGELINE_EXPORT_DIR=seed/dealer_export

# Superset (docker compose --profile bi).
SUPERSET_SECRET_KEY=dev_only_change_me

# GenBI / WrenAI (docker compose --profile genbi). The API key is injected as a
# secret (SECRET_OPENAI_API_KEY) or exported in your shell — never committed.
# Model configuration lives in docker/compose/genbi/config.yaml, not here.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Offline profile (docker compose --profile genbi --profile genbi-offline):
# point the AI service at Ollama and pick its config file.
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://ollama:11434/v1
# GENBI_AI_CONFIG_PATH=/app/config-offline.yaml
GENBI_WREN_UI_PORT=3001
# Where the read-only analytics DuckDB lives on the host (mounted into the
# engine/ibis containers at /data/analytics).
GENBI_ANALYTICS_DUCKDB_HOST_PATH=./data/analytics

# ---------------------------------------------------------------------------
# GenBI governance surface (the FastAPI control surface in api/).
# Values live ONLY here / the environment, never in the repo.
# ---------------------------------------------------------------------------

# Deployment mode: "local" (default) permits the documented dev receipt key;
# "production" fail-closes every unset or dev-default governance key.
# ENVIRONMENT=local

# Tool-approval receipts (cubiczan-chp-mcp scheme): the HMAC-SHA256 signing
# key binds each human approval to the exact normalized arguments, the policy
# version, and an expiry. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leaving it unset is fine for local dev (a documented dev-only default is
# used and printed in the module docs of api/genbi/receipts.py); production
# mode refuses to start without a real key, and the dev default is rejected
# there even if set. NEVER commit a real key anywhere.
# GENBI_APPROVAL_RECEIPT_KEY=<64 hex chars>
# Receipt ledger location (default: <state dir>/approval_receipts.jsonl, stored
# alongside the CHP decision ledger).
# GENBI_APPROVAL_RECEIPTS_PATH=

# ---------------------------------------------------------------------------
# Connector source settings (sources.yml references these; all optional until
# a site's connector is enabled — templates stay disabled with empty values).
# Values live ONLY here / the environment, never in the repo.
# ---------------------------------------------------------------------------

# File source (demo): local seeded export.
# CSV_SFTP_DROP_ROOT=seed/dealer_export

# NetSuite (SuiteTalk REST): account + OAuth1 token credentials.
# NETSUITE_SUBSIDIARIES is a comma-separated list of subsidiary internal ids
# (OneWorld server-side scoping — leave empty on non-OneWorld accounts);
# NETSUITE_ACCOUNTING_BOOK_ID scopes the GL entries query on multi-book
# tenants (empty = all books).
# NETSUITE_ACCOUNT_ID=, NETSUITE_CONSUMER_KEY=, NETSUITE_CONSUMER_SECRET=
# NETSUITE_TOKEN_ID=, NETSUITE_TOKEN_SECRET=, NETSUITE_REALM=
# NETSUITE_SUBSIDIARIES=, NETSUITE_ACCOUNTING_BOOK_ID=

# Legacy SQL pack — ODBC DSNs are configured at the OS level (odbc.ini); the
# DSN carries host/port/db. Users and passwords come from the environment.
# INFORMIX_ODBC_DSN=, INFORMIX_DB_USER=, INFORMIX_DB_PASSWORD=
# DB2_LUW_ODBC_DSN=, DB2_LUW_DB_USER=, DB2_LUW_DB_PASSWORD=
# ORACLE_ODBC_DSN=, ORACLE_DB_USER=, ORACLE_DB_PASSWORD=
# SQLSERVER_ODBC_DSN=, SQLSERVER_DB_USER=, SQLSERVER_DB_PASSWORD=
# Db2 for i: JDBC via the JT400 toolkit (JayDeBeApi bridge; JVM required).
# DB2I_JDBC_URL=jdbc:as400://host;naming=system
# DB2I_DB_USER=, DB2I_DB_PASSWORD=, DB2I_JT400_JARS=/opt/jt400
# PostgreSQL / MySQL / MariaDB (psycopg2 / PyMySQL paramstyle %s).
# PG_DB_HOST=, PG_DB_PORT=5432, PG_DB_NAME=, PG_DB_USER=, PG_DB_PASSWORD=
# MYSQL_DB_HOST=, MYSQL_DB_PORT=3306, MYSQL_DB_NAME=, MYSQL_DB_USER=, MYSQL_DB_PASSWORD=
# MARIADB_DB_HOST=, MARIADB_DB_PORT=3306, MARIADB_DB_NAME=, MARIADB_DB_USER=, MARIADB_DB_PASSWORD=
# Sybase ASE: jConnect JDBC only (no Debezium connector exists). Soft-delete
# settings are optional and must be set together.
# SYBASE_JDBC_URL=jdbc:sybase:Tds:host:5000
# SYBASE_DB_USER=, SYBASE_DB_PASSWORD=, SYBASE_JCONNECT_JARS=
# SYBASE_SOFT_DELETE_COLUMN=, SYBASE_SOFT_DELETE_VALUE=
# Progress OpenEdge: pyodbc/DataDirect ODBC (no SQLAlchemy dialect exists).
# OPENEDGE_ODBC_DSN=, OPENEDGE_DB_USER=, OPENEDGE_DB_PASSWORD=

# SAP HANA (SAP Business One on HANA): SQLAlchemy hana:// via sqlalchemy-hana
# (hdbcli client). Read-only extraction user over DBA-maintained b1_* staging
# views; db_schema is optional and qualifies every SQL path. Instance ports
# follow the 3NN15 convention (instance 90 -> 39015).
# SAP_HANA_DB_HOST=, SAP_HANA_DB_PORT=39015, SAP_HANA_DB_SCHEMA=, SAP_HANA_DB_USER=, SAP_HANA_DB_PASSWORD=

# Epicor Prophet 21 (cloud OData v4; on-prem sites use the SQL Server connector).
# P21_ODATA_URL=, P21_ODATA_USER=, P21_ODATA_PASSWORD=, P21_AS_OF_DATE=

# Epicor BisTrack: read-only ODBC (SQL Server) or the separately licensed
# BisTrack Web Smart View API (mode smartview). order_document_types is the
# per-site list of BisTrack order document types to extract — quotes, call-off
# orders, reservations, and template orders carry their own numbering sequences
# and must never be ingested as orders (spec §7.1); invoice_document_types is
# optional (empty = scan all invoice documents under one numbering watermark).
# BISTRACK_MODE=odbc, BISTRACK_ODBC_DSN=, BISTRACK_DB_USER=, BISTRACK_DB_PASSWORD=
# BISTRACK_ORDER_DOC_TYPES=, BISTRACK_INVOICE_DOC_TYPES=
# BISTRACK_SMARTVIEW_URL=, BISTRACK_SMARTVIEW_KEY=

# DMSi Agility (AgilityPublic REST): the per-dealer api_url is tied to that
# dealer's database (DMSi-hosted SaaS) and is available from the customer;
# credentials are a dealer-created Agility integration user (system-manager
# maintained) — no API keys or OAuth exist. Session/Login issues the
# SessionContextId; every data call carries ContextId + Branch headers. Contexts
# expire unused (4 h default, 24 h max) — rejection re-logins. DMSI_CUSTOMERS
# is the comma-separated CustomerID list scoping order/invoice pulls:
# CustomerID <all> is valid only with SearchBy — never a bulk path — so the
# list is pinned at onboarding (fail-closed on empty). DMSI_GO_LIVE_DATE
# (YYYY-MM-DD) bounds transaction backfills. record_fetch_limit starts at the
# Appian-tuned 500 (per-dealer chunk ceilings live in the dealer's System
# Config); invoice_window_days is the trailing re-pull window (spec §4: 7-14
# days). GL and PO lists have no AgilityPublic service — they ride the hybrid
# vendor-mediated channel (Data Warehouse / report exports / BInformed FTP).
# DMSI_API_URL=, DMSI_LOGIN_ID=, DMSI_PASSWORD=
# DMSI_CUSTOMERS=<id>,<id>, DMSI_GO_LIVE_DATE=
# DMSI_RECORD_FETCH_LIMIT=500, DMSI_INVOICE_WINDOW_DAYS=14

# ECI Spruce / RockSolid MAX: dealer-mediated file drop — no public SFTP and
# no ungated API (the SOAP Ecommerce API is NDA-gated; spec art_ktSh9Z8x §2/§8).
# Files come from scheduled-report outputs / the hosted S: cloud folder into
# ECI_CSV_DROP_ROOT, accompanied by a manifest.json control file. The three
# [D] pins are onboarding discovery outcomes — fail-closed on empty:
#   product         spruce | rsm          (the products expose different exports)
#   hosting         hosted | on_prem     (drives VPN path, archives, backfill — spec §1/§6)
#   layout_profile  spruce_report_csv | rsm_pipe_export
# ECI_QUARANTINE_DIR overrides the quarantine root (default: QUARANTINE_ROOT).
# ECI_PRODUCT=, ECI_HOSTING=, ECI_LAYOUT_PROFILE=
# ECI_CSV_DROP_ROOT=/mnt/eci-drop/dealer-0001
# ECI_QUARANTINE_DIR=

# Dynamics 365 Business Central (API v2.0 / OData v4): Entra app registration
# with API.ReadWrite.All (admin-consented) and a BC "Microsoft Entra
# applications" card with read-scoped permission sets (apps cannot get SUPER).
# D365BC_COMPANIES is a comma-separated list of BC company ids (GET /companies
# enumerates them); every extraction loops the list and checkpoints the max
# lastModifiedDateTime observed across ALL configured companies.
# D365BC_TENANT_ID=, D365BC_CLIENT_ID=, D365BC_CLIENT_SECRET=
# D365BC_ENVIRONMENT=production, D365BC_COMPANIES=<guid>,<guid>, D365BC_API_VERSION=v2.0

# Cloud ERP REST (Plex / Dynamics 365): one connector, per-tenant provider
# profiles. auth_mode: api_key (Plex default) or oauth2 (D365 client
# credentials via Microsoft Entra ID — token URL derives from AAD tenant id).
# CLOUD_ERP_PROVIDER=plex|d365, CLOUD_ERP_BASE_URL=, CLOUD_ERP_AUTH_MODE=
# CLOUD_ERP_API_KEY=, CLOUD_ERP_API_KEY_HEADER=X-API-Key
# CLOUD_ERP_TOKEN_URL=, CLOUD_ERP_OAUTH_SCOPE=, CLOUD_ERP_CLIENT_ID=, CLOUD_ERP_CLIENT_SECRET=, CLOUD_ERP_AAD_TENANT_ID=
# CLOUD_ERP_WATERMARK_FIELD=, CLOUD_ERP_INCREMENTAL_QUERY=, CLOUD_ERP_PAGE_SIZE=

# Warehouse direct-connect (connectors/warehouses/warehouses.yml — configs
# only; no extraction). See the file for the full per-warehouse key list.
# SNOWFLAKE_ACCOUNT=, SNOWFLAKE_WAREHOUSE=, SNOWFLAKE_DATABASE=, SNOWFLAKE_SCHEMA=, SNOWFLAKE_USER=, SNOWFLAKE_PASSWORD=, SNOWFLAKE_ROLE=
# BIGQUERY_PROJECT=, BIGQUERY_DATASET=, BIGQUERY_LOCATION=US, BIGQUERY_CREDENTIALS_PATH=
# CLICKHOUSE_HOST=, CLICKHOUSE_PORT=8443, CLICKHOUSE_USER=, CLICKHOUSE_PASSWORD=, CLICKHOUSE_DATABASE=, CLICKHOUSE_SECURE=true
# TRINO_HOST=, TRINO_PORT=8443, TRINO_USER=, TRINO_CATALOG=, TRINO_SCHEMA=, TRINO_PASSWORD=
# DATABRICKS_SERVER_HOSTNAME=, DATABRICKS_HTTP_PATH=, DATABRICKS_ACCESS_TOKEN=, DATABRICKS_CATALOG=, DATABRICKS_SCHEMA=
